FUNCTION_BLOCK Voting
VAR_INPUT
I1 : BOOL; // Датчик 1
I2 : BOOL; // Датчик 2
I3 : BOOL; // Датчик 3
END_VAR
VAR_OUTPUT
Q : BOOL;
NQ : BOOL;
END_VAR
VAR
LogicV3 : BOOL;
LogicV4 : BOOL;
LogicV5 : BOOL;
END_VAR
LogicV3 := I2 OR I3;
LogicV4 := I1 AND LogicV3;
LogicV5 := I2 AND I3;
Q := LogicV4 OR LogicV5;
NQ := NOT Q;
END_FUNCTION_BLOCK

