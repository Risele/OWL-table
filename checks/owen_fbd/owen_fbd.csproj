  <ItemGroup>
    <Reference Include="System.Text.Json"><HintPath>$(OwenDirectory)/System.Text.Json.dll</HintPath></Reference>
    <Reference Include="System.Text.Encodings.Web"><HintPath>$(OwenDirectory)/System.Text.Encodings.Web.dll</HintPath></Reference>
  </ItemGroup>
</Project>
