    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <OwenDirectory>C:/Program Files/Owen/Owen Logic</OwenDirectory>
